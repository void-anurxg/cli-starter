{
  "name": "cli-starter",
  "version": "1.0.0",
  "description": "",
  "bin" : "./bin/cli.js",
  "main": "index.js",
  "scripts": {
    "test": "pnpm build && tsup -p test/tsup.config.ts && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "start": "node dist/index.js",
    "prebuild": "rimraf dist",
    "build": "tsup",
    "build:start": "pnpm build && pnpm start",
    "dev": "tsup --watch  --onSuccess \"node dist/index.js\"",
    "info:routes": "fastify print-routes ./dist/index.js",
    "info:swagger": "fastify generate-swagger ./dist/index.js",
    "prisma:link": "rimraf ./node_modules/.prisma && cp -r ./node_modules/.prisma && rimraf ./node_modules/@prisma && cp -r ./node_modules/@prisma",
    "postinstall": "pnpm prisma:link",
    "clean": "rimraf node_modules && rm pnpm-lock.yaml",
    "clean:i": "pnpm clean && pnpm i"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.7",
    "close-with-grace": "^2.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fastify-cli": "^6.3.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.1",
    "get-stream": "^9.0.1",
    "nanoid": "^5.0.7",
    "rimraf": "^6.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/get-stream": "^3.0.2",
    "@types/node": "^20.4.4",
    "c8": "^10.1.2",
    "concurrently": "^8.2.2",
    "fastify-tsconfig": "^2.0.0",
    "pino-pretty": "^11.2.2",
    "ts-node": "^10.4.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
